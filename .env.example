# Template only: copy to .env (gitignored) and fill in. Never commit real values.
# Only ic_plus reads .env (envfile.py); the graded incident_commander package reads none.
# Flags --llm-url / --model win over these; LLM_API_KEY is used by --llm hosted only.
# Local (Ollama, no key):   LLM_BASE_URL=http://localhost:11434/v1
# Hosted (OpenAI-compatible, key required), e.g. Groq: LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
